{
  "name": "fastify-type-provider-schemastery",
  "version": "1.1.1",
  "description": "Schemastery type provider for Fastify",
  "keywords": [
    "fastify",
    "schemastery"
  ],
  "homepage": "https://github.com/DreamOfIce/FastifyTypeProviderSchemastery#readme",
  "bugs": {
    "url": "https://github.com/DreamOfIce/FastifyTypeProviderSchemastery/issues"
  },
  "license": "MIT",
  "author": "DreamOfIce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamOfIce/FastifyTypeProviderSchemastery.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "husky",
    "release": "dotenv run -- release-it"
  },
  "dependencies": {
    "@dreamofice/schemastery-json-schema": "^1.0.0",
    "cosmokit": "^1.8.1",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fastify/ajv-compiler": "^4.0.6",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.1",
    "dotenv": "^18.0.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^21.0.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "fastify": "^5.12.5",
    "schemastery": "^3.18.0"
  },
  "nano-staged": {
    "*": "pnpm fmt --no-error-on-unmatched-pattern",
    "*.{c,m}?{js,ts}": "pnpm lint"
  },
  "packageManager": "pnpm@12.4.2"
}
